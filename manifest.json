{
  "manifest_version": 3,
  "name": "Kleinanzeigen +",
  "version": "1.0.0",
  "description": "Vorlagen für Kleinanzeigen speichern, wiederverwenden und Inserate schneller erstellen.",
  "action": {
    "default_title": "Kleinanzeigen +",
    "default_popup": "popup.html?view=popup"
  },
  "options_page": "pages/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.kleinanzeigen.de/*",
    "https://kleinanzeigen.de/*",
    "https://*.kleinanzeigen.de/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/brand-mark.svg", "shared/ui.css"],
      "matches": [
        "https://www.kleinanzeigen.de/*",
        "https://kleinanzeigen.de/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kleinanzeigen.de/*",
        "https://kleinanzeigen.de/*"
      ],
      "js": ["shared/model.js", "content/ui.js", "content/site.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kleinanzeigen.de/p-anzeige-bearbeiten.html*",
        "https://kleinanzeigen.de/p-anzeige-bearbeiten.html*",
        "https://www.kleinanzeigen.de/p-anzeige-aufgeben-schritt2.html*",
        "https://kleinanzeigen.de/p-anzeige-aufgeben-schritt2.html*"
      ],
      "js": ["content/form-tools.js"],
      "run_at": "document_idle"
    }
  ]
}
